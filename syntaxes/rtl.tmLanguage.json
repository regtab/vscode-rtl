{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RTL",
  "scopeName": "source.rtl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#fragment-def-row" },
    { "include": "#fragment-def-cell" },
    { "include": "#fragment-def-subtable" },
    { "include": "#fragment-def-subrow" },
    { "include": "#subtable" },
    { "include": "#row" },
    { "include": "#atoms" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.rtl"
    },

    "subtable": {
      "comment": "Explicit subtable pattern { … } or subtable fragment ref {$N}. Structural level 1; scope prefix keyword.control gives it a fixed theme color.",
      "begin": "\\{(?!\\d+\\})",
      "beginCaptures": { "0": { "name": "keyword.control.subtable.bracket.rtl" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "keyword.control.subtable.bracket.rtl" } },
      "patterns": [{ "include": "#subtable-content" }]
    },
    "subtable-content": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#row" },
        { "include": "#atoms" }
      ]
    },

    "row": {
      "comment": "Row pattern [ … ] or row fragment ref [$N]. Structural level 2; scope prefix entity.name.function.",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "entity.name.function.row.bracket.rtl" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "entity.name.function.row.bracket.rtl" } },
      "patterns": [{ "include": "#row-content" }]
    },
    "row-content": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#subrow" },
        { "include": "#cell" },
        { "include": "#atoms" }
      ]
    },

    "subrow": {
      "comment": "Explicit subrow pattern { … } or subrow fragment ref {$N} inside a row. Structural level 3; scope prefix entity.name.type. The lookahead keeps the exact quantifier {n} out.",
      "begin": "\\{(?!\\d+\\})",
      "beginCaptures": { "0": { "name": "entity.name.type.subrow.bracket.rtl" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "entity.name.type.subrow.bracket.rtl" } },
      "patterns": [{ "include": "#subrow-content" }]
    },
    "subrow-content": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#cell" },
        { "include": "#atoms" }
      ]
    },

    "cell": {
      "comment": "Cell pattern [ … ] or cell fragment ref [$N]. Structural level 4; neutral punctuation color.",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.cell.bracket.rtl" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.cell.bracket.rtl" } },
      "patterns": [{ "include": "#cell-content" }]
    },
    "cell-content": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#atoms" }
      ]
    },

    "fragment-def-row": {
      "comment": "$N=[ [ … ]+ ] — a row-level fragment definition (body starts with a nested [).",
      "begin": "(\\$[A-Za-z][A-Za-z0-9_]*)\\s*(=)\\s*(\\[)(?=\\s*\\[)",
      "beginCaptures": {
        "1": { "name": "variable.other.fragment.rtl" },
        "2": { "name": "keyword.operator.rtl" },
        "3": { "name": "entity.name.function.row.bracket.rtl" }
      },
      "end": "\\]",
      "endCaptures": { "0": { "name": "entity.name.function.row.bracket.rtl" } },
      "patterns": [{ "include": "#row-content" }]
    },
    "fragment-def-cell": {
      "comment": "$N=[cellBody] — a cell-level fragment definition.",
      "begin": "(\\$[A-Za-z][A-Za-z0-9_]*)\\s*(=)\\s*(\\[)(?!\\s*\\[)",
      "beginCaptures": {
        "1": { "name": "variable.other.fragment.rtl" },
        "2": { "name": "keyword.operator.rtl" },
        "3": { "name": "punctuation.section.cell.bracket.rtl" }
      },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.cell.bracket.rtl" } },
      "patterns": [{ "include": "#cell-content" }]
    },
    "fragment-def-subtable": {
      "comment": "$N={ [ [ … ] ]+ } — a subtable-level fragment definition (rows inside).",
      "begin": "(\\$[A-Za-z][A-Za-z0-9_]*)\\s*(=)\\s*(\\{)(?=\\s*\\[\\s*\\[)",
      "beginCaptures": {
        "1": { "name": "variable.other.fragment.rtl" },
        "2": { "name": "keyword.operator.rtl" },
        "3": { "name": "keyword.control.subtable.bracket.rtl" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "keyword.control.subtable.bracket.rtl" } },
      "patterns": [{ "include": "#subtable-content" }]
    },
    "fragment-def-subrow": {
      "comment": "$N={ [cell]+ } — a subrow-level fragment definition (fallback for brace bodies).",
      "begin": "(\\$[A-Za-z][A-Za-z0-9_]*)\\s*(=)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "variable.other.fragment.rtl" },
        "2": { "name": "keyword.operator.rtl" },
        "3": { "name": "entity.name.type.subrow.bracket.rtl" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "entity.name.type.subrow.bracket.rtl" } },
      "patterns": [{ "include": "#subrow-content" }]
    },

    "atoms": {
      "comment": "Non-structural tokens, shared by every context.",
      "patterns": [
        { "include": "#string" },
        { "include": "#quantifier-exact" },
        { "include": "#fragment-id" },
        { "include": "#settings-and-extractors" },
        { "include": "#positional-constraint" },
        { "include": "#item-derivation" },
        { "include": "#action" },
        { "include": "#provider" },
        { "include": "#content-keyword" },
        { "include": "#tag" },
        { "include": "#context-avp" },
        { "include": "#arrow" },
        { "include": "#range" },
        { "include": "#number" },
        { "include": "#quantifier" },
        { "include": "#operator" },
        { "include": "#bracket" }
      ]
    },
    "string": {
      "patterns": [
        {
          "match": "'(?:`'|''|[^'])*'",
          "name": "string.quoted.single.rtl"
        },
        {
          "match": "\"(?:`\"|\"\"|[^\"])*\"",
          "name": "string.quoted.double.rtl"
        },
        {
          "match": "“[^”″]*(?:”|″)",
          "name": "string.quoted.other.smart.rtl"
        }
      ]
    },
    "fragment-id": {
      "match": "\\$[A-Za-z][A-Za-z0-9_]*",
      "name": "variable.other.fragment.rtl"
    },
    "settings-and-extractors": {
      "match": "(?i)\\b(NORM|ANCH|SPLIT|SUBSTR|REPL|UC|LC|TRIM)\\b",
      "name": "support.function.extractor.rtl"
    },
    "positional-constraint": {
      "match": "(?i)\\b([CRP])(?=[+-]?\\d)",
      "name": "support.constant.positional.rtl"
    },
    "item-derivation": {
      "patterns": [
        {
          "match": "(?i)\\b(ATTR|VAL|AUX|SKIP)\\b",
          "name": "storage.type.item.rtl"
        },
        {
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])",
          "name": "storage.type.item.skip.rtl"
        }
      ]
    },
    "action": {
      "match": "(?i)\\b(FILL|PREFIX|SUFFIX|AVP|REC|JOIN)\\b",
      "name": "keyword.control.action.rtl"
    },
    "provider": {
      "match": "(?i)\\b(LT|RT|AV|BW|ROW|COL|SR|SC|ST|NCL|CL)\\b",
      "name": "support.constant.provider.rtl"
    },
    "content-keyword": {
      "match": "(?i)\\b(BLANK|STR|EXT)\\b",
      "name": "constant.language.content.rtl"
    },
    "tag": {
      "match": "!?#",
      "name": "entity.name.tag.rtl"
    },
    "context-avp": {
      "match": "@",
      "name": "keyword.operator.context-avp.rtl"
    },
    "arrow": {
      "match": "->",
      "name": "keyword.operator.arrow.rtl"
    },
    "range": {
      "match": "\\.\\.",
      "name": "keyword.operator.range.rtl"
    },
    "number": {
      "match": "[+-]?\\d+",
      "name": "constant.numeric.rtl"
    },
    "quantifier-exact": {
      "match": "\\{\\d+\\}",
      "name": "keyword.operator.quantifier.rtl"
    },
    "quantifier": {
      "match": "[+*?]",
      "name": "keyword.operator.quantifier.rtl"
    },
    "operator": {
      "match": "[&|!=:~^,]",
      "name": "keyword.operator.rtl"
    },
    "bracket": {
      "match": "[\\[\\]{}()<>]",
      "name": "punctuation.section.bracket.rtl"
    }
  }
}
